import re

email = input("Enter email address: ")

pattern = r'^([^@]+)@([^@]+)\.([a-zA-Z]+)$'
match = re.match(pattern, email)

if match:
    print("Username:", match.group(1))
    print("Domain:", match.group(2))
    print("Extension:", match.group(3))
else:
    print("Invalid email address")

Output:

Enter email address: student@gmail.com
Username: student
Domain: gmail
Extension: com

Result: The program identifies the username, domain name, and extension of an email address.
