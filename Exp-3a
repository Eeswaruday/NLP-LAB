from nltk.util import ngrams

text = "Python is easy to learn"
words = text.split()

# User-defined function
def generate(words, n):
    return list(zip(*[words[i:] for i in range(n)]))

print("User-defined Unigrams:", generate(words, 1))
print("User-defined Bigrams:", generate(words, 2))
print("User-defined Trigrams:", generate(words, 3))

# Pre-defined function
for n in range(1, 5):
    print(f"{n}-grams:", list(ngrams(words, n)))
