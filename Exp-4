import nltk
from nltk.collocations import BigramCollocationFinder
from nltk.metrics import BigramAssocMeasures

words_list = ["apple", "application", "apply", "banana", "processing", "language", "nlp", "code"]

corpus_words = nltk.corpus.brown.words()[:2000]
finder = BigramCollocationFinder.from_words(corpus_words)
collocations = finder.nbest(BigramAssocMeasures.pmi, 5)
print("Top 5 Collocations:", collocations)

prefix = "app"
prefix_matches = [w for w in words_list if w.startswith(prefix)]
print(f"Words starting with '{prefix}':", prefix_matches)

long_words = [w for w in words_list if len(w) > 4]
print("Words longer than 4 characters:", long_words)
